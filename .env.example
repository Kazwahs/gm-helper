# Copy this file to .env (in the same folder as docker-compose.yml) and fill
# in your own values. .env is gitignored - your paths/UID never get committed.

# Required: where your TTRPG PDF library lives on the host.
GM_HELPER_LIBRARY_DIR=/path/to/your/library

# Optional: where GM Helper's database + config should persist on the host.
# Defaults to a "data" folder next to docker-compose.yml if left unset.
#GM_HELPER_DATA_DIR=/path/to/appdata/gmhelper

# Optional: host port for the web UI. Defaults to 8000 if left unset.
#GM_HELPER_PORT=8000

# Optional: UID/GID to run the container as. Defaults to 1000:1000.
#PUID=1000
#PGID=1000
