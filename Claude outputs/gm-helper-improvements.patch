+        made.append(path)
+        return path
+
+    monkeypatch.setattr(backup, "make_backup", spy)
+    client.get("/backup/full")
+    client.get("/backup/user-data")
+    import os
+    assert len(made) == 2
+    assert not any(os.path.exists(p) for p in made)
+
+
+def test_make_backup_rejects_unknown_kind(db):
